# --- Server ---
PORT=3000

# OPTIONAL API key. If unset, the proxy is open (no auth) — fine for localhost.
# If set, every /v1/* request must send it as either:
#   Authorization: Bearer <key>   OR   X-API-Key: <key>
# API_KEY=your_secret_api_key

# Network binding. Defaults to 127.0.0.1 (localhost only).
# Set HOST=0.0.0.0 to expose the proxy on your LAN.
# HOST=127.0.0.1

# --- CORS ---
# Comma-separated allowlist of browser origins. Empty = no cross-origin access.
# Use '*' to allow any origin (explicit opt-in).
# CORS_ORIGINS=http://localhost:5173,https://my-app.example

# --- Limits ---
# Max request body size in bytes (default 10 MiB).
# MAX_BODY_BYTES=10485760
# Requests per window per IP (default 120) and window length in ms (default 60000).
# RATE_LIMIT=120
# RATE_WINDOW_MS=60000

# --- Browser / providers ---
# Default browser engine: chromium | firefox | chrome | edge | webkit
# BROWSER=chromium
# Run DOM providers (DeepSeek, Qwen) with a visible window instead of headless.
# DOM_HEADFUL=1
# Dump a screenshot + HTML when a DOM generation finishes (selector calibration).
# DOM_DEBUG=1
# Custom path for the Kimi browser profile (default: kimi_profile).
# KIMI_PROFILE=kimi_profile
